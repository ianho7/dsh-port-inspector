{
  "name": "dsh-runtime-inspector",
  "version": "0.1.1",
  "description": "Windows Runtime Inspector Bundle for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "https://github.com/ianho7/dsh-runtime-inspector.git"
  },
  "homepage": "https://github.com/ianho7/dsh-runtime-inspector#readme",
  "bugs": {
    "url": "https://github.com/ianho7/dsh-runtime-inspector/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./compatibility": {
      "types": "./lib/compatibility.d.ts",
      "default": "./lib/compatibility.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "npm run clean:build && npm run build:host && npm run build:client",
    "clean:build": "node scripts/clean-build-output.mjs",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "tsdown --config tsdown.config.ts",
    "website:dev": "npm --prefix website run dev",
    "website:build": "npm --prefix website run build",
    "website:preview": "npm --prefix website run preview",
    "update:toolchain-logos": "node scripts/update-toolchain-logos.mjs",
    "normalize:toolchain-logo-candidates": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/normalize-toolchain-logo-candidates.ps1",
    "sync:toolchain-logo-candidates": "node scripts/sync-toolchain-logo-candidates.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "dependencies": {
    "koffi": "^3.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.1",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "license": "MIT"
}
