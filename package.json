{
  "name": "dsh-runtime-inspector",
  "version": "0.1.0",
  "description": "Windows Runtime Inspector Bundle for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./compatibility": {
      "types": "./lib/compatibility.d.ts",
      "default": "./lib/compatibility.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "0.1.0-rc.8 || 0.1.1-rc.1"
  },
  "dependencies": {
    "koffi": "^3.1.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "license": "MIT"
}
